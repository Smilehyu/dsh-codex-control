{
  "name": "dsh-codex-control",
  "version": "0.1.0",
  "description": "Codex-led control of dedicated sessions in the running DeepSeek Harness Host",
  "type": "module",
  "main": "src/plugin.js",
  "exports": { ".": "./src/plugin.js", "./package.json": "./package.json" },
  "bin": { "dsh-codex-control-mcp": "bin/mcp.js" },
  "files": ["src", "bin", "scripts", "examples", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "compatibility": { "dsh": ">=0.2.1-rc.2 <0.2.2-0" }
  },
  "engines": { "node": ">=22.19.0" },
  "scripts": { "test": "node --test test/*.test.js", "check": "node --check src/plugin.js && node --check bin/mcp.js" },
  "dependencies": { "@modelcontextprotocol/sdk": "1.30.0", "zod": "4.4.3" },
  "license": "MIT"
}
